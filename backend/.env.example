# Replace <PASSWORD> with the value from the root .env (POSTGRES_PASSWORD)
DATABASE_URL=postgres://jobaggr_user:<PASSWORD>@127.0.0.1:5432/jobaggr_bdd

# Same value as PEPPER the root .env 
PEPPER=
# Same value as JWT_SECRET in the root .env 
JWT_SECRET=

RUST_LOG=info,jobaggr_backend=debug,tower_http=debug,sqlx=warn
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
